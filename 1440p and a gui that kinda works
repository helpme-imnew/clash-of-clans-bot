# ---------- CONTROL FUNCTIONS ----------
def start_bot():
    global running, paused
    if not running:
        running = True
        paused = False
        t = threading.Thread(target=coc_loop, daemon=True)
        t.start()
    else:
        paused = False  # resume if paused


def pause_bot():
    global paused
    paused = True


def reset_bot():
    global running, paused, reset_flag
    paused = False
    reset_flag = True
    running = False   # stop current thread; next Start will spawn a new one


# ---------- HOTKEYS ----------
# F8 start/resume, F9 pause, F10 reset
keyboard.add_hotkey('f8', start_bot)
keyboard.add_hotkey('f9', pause_bot)
keyboard.add_hotkey('f10', reset_bot)  # [web:33][web:36]


